rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. User Profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Monthly Records
      match /months/{monthKey} {
        allow read, write: if isOwner(userId) && isValidId(userId);

        // Daily Expenses
        match /expenses/{expenseId} {
          allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(expenseId);
        }
      }

      // Udhar (Money Lent) Records
      match /udhars/{udharId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(udharId);
      }
    }
  }
}
